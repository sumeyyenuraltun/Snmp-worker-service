{
  "ReverseProxy": {
    "Routes": {
      "snmpApi": {
        "ClusterId": "snmpCluster",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "snmpCluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7038/"
          }
        }
      }
    }
  }
}